+fn bounded_subband_minimum_len(
+    golomb_len: usize,
+    winner_bytes: Option<&Vec<u8>>,
+) -> usize {
+    let tagged_len = winner_bytes
+        .map(Vec::len)
+        .unwrap_or(golomb_len)
+        .saturating_add(1);
+    golomb_len.min(tagged_len)
+}
