+#[test]
+fn bounded_channel_rejects_cumulative_subbands_before_retaining_all_outputs() {
+    let signal = (0..4096)
+        .map(|sample| ((sample * 7919) % 65_521) as i64 - 32_760)
+        .collect::<Vec<_>>();
+    let subbands = forward_subbands(&signal, 3);
+    let mut body_sizes = Vec::new();
+    for (subband_index, subband) in subbands.iter().enumerate() {
+        let scoped = scope_lpc_mode(lpc::LpcMode::Fixed, lpc_max_order(subband.len()));
+        let (coefficients, residual, _) =
+            lpc::analyze_with_mode(subband, subband_index, scoped, BIAS_CTX, None);
+        body_sizes.push(
+            1usize
+                .saturating_add(coefficients.len().saturating_mul(4))
+                .saturating_add(golomb::encoded_byte_len(&residual).expect("Golomb size")),
+        );
+    }
+    let largest_subband = body_sizes.iter().copied().max().expect("subbands");
+    let complete_body = body_sizes.iter().copied().sum::<usize>();
+    assert!(complete_body > largest_subband);
+    let ceiling = largest_subband + (complete_body - largest_subband) / 2;
+
+    let error =
+        encode_one_channel_bounded(
+            &signal,
+            3,
+            lpc::LpcMode::Fixed,
+            false,
+            false,
+            false,
+            ceiling,
+        )
+        .expect_err("cumulative subbands must exceed channel budget");
+    assert!(matches!(
+        error,
+        LmlError::OutputLimit {
+            context: "LML channel lower bound",
+            ..
+        }
+    ));
+}
