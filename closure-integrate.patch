+fn bounded_channel_minimum_len(
+    metadata_len: usize,
+    subbands: &[BoundedSubbandOutput],
+) -> usize {
+    subbands.iter().fold(metadata_len, |total, subband| {
+        total.saturating_add(bounded_subband_minimum_len(
+            subband.golomb_len,
+            subband.winner_bytes.as_ref(),
+        ))
+    })
+}
