+
+fn bounded_tagged_payload(per_channel: &[CompleteBoundedChannel]) -> bool {
+    let (subband_count, savings) = per_channel
+        .iter()
+        .flat_map(|channel| &channel.subbands)
+        .fold((0usize, 0usize), |(count, total), subband| {
+            (
+                count.saturating_add(1),
+                total.saturating_add(subband.savings),
+            )
+        });
+    savings > subband_count
