+
+fn bounded_channel_minimum_len(metadata_len: usize, subbands: &[CompleteBoundedSubband]) -> usize {
+    subbands.iter().fold(metadata_len, |total, subband| {
+        total.saturating_add(bounded_subband_minimum_len(
+            subband.golomb_len,
+            subband.winner_bytes.as_deref(),
+        ))
+    })
+}
+
+fn bounded_minimum_body_len(per_channel: &[CompleteBoundedChannel]) -> usize {
+    per_channel.iter().fold(0usize, |total, channel| {
+        total.saturating_add(bounded_channel_minimum_len(
+            channel.meta.len(),
+            &channel.subbands,
+        ))
+    })
+}
+
+fn bounded_payload_len(per_channel: &[CompleteBoundedChannel], tagged: bool) -> usize {
+    per_channel
+        .iter()
+        .flat_map(|channel| &channel.subbands)
+        .fold(0usize, |total, subband| {
+            let encoded_len = if tagged {
+                subband
+                    .winner_bytes
+                    .as_ref()
+                    .map(Vec::len)
+                    .unwrap_or(subband.golomb_len)
+                    .saturating_add(1)
+            } else {
+                subband.golomb_len
+            };
+            total.saturating_add(encoded_len)
+        })
+}
+
+fn append_bounded_golomb(out: &mut Vec<u8>, subband: &CompleteBoundedSubband) -> LmlResult<()> {
+    match &subband.golomb {
+        BoundedGolomb::Encoded(bytes) => out.extend_from_slice(bytes),
+        #[cfg(any(feature = "experimental_bit_pack", feature = "experimental_arithmetic"))]
+        BoundedGolomb::Deferred(residual) => {
+            let bytes = golomb::encode_dense_bounded(residual, subband.golomb_len)?;
+            out.extend_from_slice(&bytes);
+        }
+    }
+    Ok(())
+}
