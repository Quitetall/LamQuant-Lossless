+
+fn output_limit_required(error: &LmlError) -> Option<u64> {
+    match error {
+        LmlError::OutputLimit { required_bytes, .. } => Some(*required_bytes),
+        LmlError::Golomb(crate::codec_errors::GolombError::OutputLimitExceeded {
+            encoded_bytes,
+            ..
+        }) => Some(*encoded_bytes as u64),
+        _ => None,
