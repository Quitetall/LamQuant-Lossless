+    let mut out = Vec::with_capacity(packet_len);
+    out.extend_from_slice(prefix.as_bytes());
+    out.extend_from_slice(MAGIC);
+    out.extend_from_slice(&header_var);
+    let crc_offset = out.len();
+    out.extend_from_slice(&[0u8; 4]);
+    let metadata_offset = out.len();
+    for channel in per_channel {
+        out.extend_from_slice(&channel.meta);
+    }
+    let payload_offset = out.len();
+    for channel in per_channel {
+        for subband in &channel.subbands {
+            if tagged {
+                out.push(subband.winner_tag);
+                if let Some(bytes) = &subband.winner_bytes {
+                    out.extend_from_slice(bytes);
