+
+#[derive(Debug)]
+struct CompleteBoundedSubband {
+    golomb_len: usize,
+    golomb: BoundedGolomb,
+    winner_tag: u8,
+    winner_bytes: Option<Vec<u8>>,
+    savings: usize,
