+fn output_limit_error(
+    required_bytes: usize,
+    maximum_bytes: usize,
+    context: &'static str,
+) -> LmlError {
+    LmlError::OutputLimit {
+        required_bytes: required_bytes as u64,
+        maximum_bytes: maximum_bytes as u64,
+        context,
+    }
+}
+
+fn enforce_output_limit(
+    required_bytes: usize,
+    maximum_bytes: usize,
+    context: &'static str,
+) -> LmlResult<()> {
+    if required_bytes > maximum_bytes {
+        Err(output_limit_error(required_bytes, maximum_bytes, context))
+    } else {
+        Ok(())
+    }
