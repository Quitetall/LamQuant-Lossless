+    header_var[2..4].copy_from_slice(&(t as u16).to_le_bytes());
+    header_var[4] = n_levels;
+    header_var[5] = flags;
+    header_var[6..10].copy_from_slice(&lpc_meta_len_u32.to_le_bytes());
+    header_var[10..14].copy_from_slice(&payload_len_u32.to_le_bytes());
